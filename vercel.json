{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/mcp/:secret",
      "destination": "/api/mcp?key=:secret"
    },
    {
      "source": "/api/admin",
      "destination": "/api/mcp?mode=admin"
    },
    {
      "source": "/api/link-gui",
      "destination": "/api/mcp?mode=linkGui"
    },
    {
      "source": "/api/xem-su-kien",
      "destination": "/api/mcp?mode=xemSuKien"
    },
    {
      "source": "/xem/:t",
      "destination": "/api/mcp?mode=xem&t=:t"
    }
  ]
}
