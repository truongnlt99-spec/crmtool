{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/mcp/:secret",
      "destination": "/api/mcp?key=:secret"
    },
    {
      "source": "/api/share",
      "destination": "/api/mcp?mode=share"
    },
    {
      "source": "/xem",
      "destination": "/xem.html"
    }
  ]
}
