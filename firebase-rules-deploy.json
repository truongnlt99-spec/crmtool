{
  "rules": {
    ".read": false,
    ".write": false,
    "crmData": {
      ".read": "auth != null && auth.uid === '7ePgCPmzxHdEAEazHo9IkyKf2rw2'",
      ".write": "auth != null && auth.uid === '7ePgCPmzxHdEAEazHo9IkyKf2rw2'",
      "leads": {
        ".indexOn": [
          "ownerUid"
        ],
        "$leadId": {
          ".validate": "newData.hasChildren(['id', 'name', 'stage'])",
          "ownerUid": {
            ".validate": "!newData.exists() || newData.isString()"
          },
          "stage": {
            ".validate": "newData.val().matches(/^(leadin|baogia|follow1|follow2|follow3|nuoidaihan|won|lost)$/)"
          },
          "revenueExpected": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "revenueActual": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      },
      "planRevenue": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "planLeads": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    },
    "crmData_users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "leads": {
          ".indexOn": [
            "ownerUid"
          ],
          "$leadId": {
            ".validate": "newData.hasChildren(['id', 'name', 'stage'])",
            "ownerUid": {
              ".validate": "!newData.exists() || newData.isString()"
            },
            "stage": {
              ".validate": "newData.val().matches(/^(leadin|baogia|follow1|follow2|follow3|nuoidaihan|won|lost)$/)"
            },
            "revenueExpected": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "revenueActual": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },
        "planRevenue": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "planLeads": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "appConfig": {
      ".read": "auth != null && auth.uid === '7ePgCPmzxHdEAEazHo9IkyKf2rw2'",
      ".write": "auth != null && auth.uid === '7ePgCPmzxHdEAEazHo9IkyKf2rw2'",
      "mcpSecret": {
        ".validate": "newData.isString() && newData.val().length >= 32 && newData.val().length <= 200"
      }
    },
    "appConfig_users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "mcpSecret": {
          ".validate": "newData.isString() && newData.val().length >= 32 && newData.val().length <= 200"
        }
      }
    },
    "shareLog_users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "shareLog": {
      ".read": "auth != null && auth.uid === '7ePgCPmzxHdEAEazHo9IkyKf2rw2'",
      ".write": false
    },
    "authLog": {
      ".read": "auth != null && auth.uid === '7ePgCPmzxHdEAEazHo9IkyKf2rw2'",
      "$entry": {
        ".write": "auth != null && (!data.exists() || auth.uid === '7ePgCPmzxHdEAEazHo9IkyKf2rw2')",
        ".validate": "newData.hasChildren(['at', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('at').isString()"
      }
    }
  }
}
